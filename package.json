    "devDependencies": {
        "@types/node": "^22.10.2",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^9.32.0",
        "laravel-vite-plugin": "^1.1.0",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
